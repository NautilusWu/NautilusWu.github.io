---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import ArticleCard from '../components/ArticleCard.astro';
import Icon from '../components/Icon.astro';
import { profile, contact, focus, education, interests, now } from '../data/site';
import { formatPeriod, workRoles } from '../lib/experience';
import { formatDate } from '../lib/format';
import { readingStats } from '../lib/reading-time';

const posts = (await getCollection('writing', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, 2);

/* The overview shows the most recent work and teaching; /experience has it all. */
const recentRoles = workRoles.slice(0, 4);

/* Sections number themselves, so hiding one (Writing, while there are no
   posts) never leaves a gap in the sequence. */
let section = 0;
const nextIndex = () => String(++section).padStart(2, '0');
---

<BaseLayout bleed>
  <section class="home-hero band" aria-labelledby="intro-title">
    <div class="shell">
      <div class="band-overline">
        <span>Builder. Learner. Curious by default.</span>
        <span class="hero-location">
          {profile.location} <span aria-hidden="true">↗</span>
        </span>
      </div>

      <div class="home-hero-body">
        <h1 id="intro-title">
          {profile.name}
          <span class="title-dot" aria-hidden="true">
            .
          </span>
        </h1>
        <p class="home-headline">
          <span>{profile.tagline}</span>
        </p>
        <p class="home-description">{profile.summary}</p>
        <div class="hero-actions">
          <a class="btn btn-primary" href="/experience">
            See my experience <Icon name="arrow" class="icon-arrow" />
          </a>
          <a class="btn" href="/resume">
            View résumé <Icon name="arrow-up-right" />
          </a>
        </div>
        {profile.status && (
          <p class="home-status">
            <span aria-hidden="true" />
            {profile.status}
          </p>
        )}
      </div>

      <div class="band-bottomline">
        <span>{profile.discipline.join(' / ')}</span>
        <a href="#about">
          Scroll to explore <span aria-hidden="true">↓</span>
        </a>
      </div>
    </div>
  </section>

  <div class="affiliation-strip">
    <div class="shell affiliation-inner">
      <div>
        <span class="affiliation-mark" aria-hidden="true">
          M
        </span>
        <span>
          {profile.affiliation}
          <small>{education[0].degree}</small>
        </span>
      </div>
      <a href="/resume">
        Education &amp; honours <Icon name="arrow-up-right" />
      </a>
    </div>
  </div>

  <div class="shell">
    <Section index={nextIndex()} label="About me" title="A little about me." id="about">
      <div class="about-grid">
        <div class="stack-m" data-reveal>
          {profile.bio.map((paragraph) => (
            <p>{paragraph}</p>
          ))}
        </div>

        <aside class="now-card" data-reveal style="--reveal-delay:80ms" aria-label="Now">
          <p class="now-stamp">
            Now · updated <time datetime={now.updated}>{formatDate(new Date(now.updated))}</time>
          </p>
          <ul class="now-list">
            {now.items.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </aside>
      </div>
    </Section>

    <Section index={nextIndex()} label="Experience" title="Where I've worked and taught.">
      <a slot="aside" class="link-arrow" href="/experience">
        All experience
      </a>
      <div class="deflist">
        {recentRoles.map((role) => (
          <div class="defrow" data-reveal>
            <span class="defkey">{formatPeriod(role)}</span>
            <ul class="defval glance">
              <li>
                <strong>{role.role}</strong>
                <span class="glance-meta">
                  {role.org} · {role.location}
                </span>
              </li>
            </ul>
          </div>
        ))}
      </div>
    </Section>

    <Section index={nextIndex()} label="At the intersection" title="Three ways I think.">
      <Fragment slot="aside">
        From a question to a model,
        <br />
        from a model to something people use.
      </Fragment>
      <div class="focus-grid">
        {focus.map((item, index) => (
          <article class="focus-item" data-reveal style={`--reveal-delay:${index * 70}ms`}>
            <span class="focus-number">
              0{index + 1}
              <Icon name={index === 0 ? 'spark' : index === 1 ? 'arrow' : 'clock'} />
            </span>
            <h3>{item.title}</h3>
            <p>{item.body}</p>
            <p class="focus-tools">{item.tags.join(' / ')}</p>
          </article>
        ))}
      </div>
    </Section>

    {posts.length > 0 && (
      <Section index={nextIndex()} label="Writing" title="Thinking out loud.">
        <a slot="aside" class="link-arrow" href="/writing">
          All writing
        </a>
        <div class="grid grid-2">
          {posts.map((post) => (
            <ArticleCard post={post} readingTime={readingStats(post.body).minutes} />
          ))}
        </div>
      </Section>
    )}

    <Section index={nextIndex()} label="Outside work" title="Away from the keyboard.">
      <div class="grid grid-3">
        {interests.map((item, index) => (
          <article class="card" data-reveal style={`--reveal-delay:${index * 70}ms`}>
            <h3>{item.title}</h3>
            <p>{item.body}</p>
          </article>
        ))}
      </div>
    </Section>

    <section class="home-contact" aria-labelledby="contact-title" data-reveal>
      <div>
        <p class="section-kicker">Have an interesting problem?</p>
        <h2 id="contact-title">
          Let's compare notes<span>.</span>
        </h2>
        <p>Research, collaborations, or a good question. My inbox is open.</p>
      </div>
      <a
        class="contact-orbit"
        href={`mailto:${contact.email}`}
        aria-label={`Email ${profile.name} at ${contact.email}`}
      >
        <Icon name="arrow-up-right" size="2.2rem" />
      </a>
      <a class="contact-address" href={`mailto:${contact.email}`}>
        {contact.email}
      </a>
    </section>
  </div>
</BaseLayout>
