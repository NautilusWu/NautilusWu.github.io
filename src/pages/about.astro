---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Section from '../components/Section.astro';
import Icon from '../components/Icon.astro';
import { profile, socials, interests, now } from '../data/site';
import { formatDate } from '../lib/format';
---

<BaseLayout
  title="About"
  description="About Edward Wu — how I got here, what I'm working on now, and how to get in touch."
>
  <PageHeader
    eyebrow="About"
    title="Curiosity first, rigour right behind it"
    lede="A short account of what I care about, inside the lab and outside it."
  />

  <Section title="Background" index="01" label="Bio">
    <div class="prose-width stack-m" data-reveal>
      {profile.intro.map((paragraph) => (
        <p>{paragraph}</p>
      ))}

      <p>
        I came to physics through instruments rather than equations. I wanted to know how a
        measurement is actually made — what has to be true for the resulting number to mean anything
        at all. Computation turned out to be the other half of that answer, so I spend my time
        moving between the two, and I've stopped thinking of them as separate skills.
      </p>

      <p>
        Longer term I want to do doctoral work where simulation, experiment, and modern machine
        learning inform one another rather than sitting in separate rooms with separate
        vocabularies.
      </p>
    </div>
  </Section>

  <Section title="Now" index="02" label="Current">
    <div class="now-card" data-reveal>
      <p class="now-stamp">
        Updated <time datetime={now.updated}>{formatDate(new Date(now.updated))}</time>
      </p>
      <ul class="now-list">
        {now.items.map((item) => (
          <li>{item}</li>
        ))}
      </ul>
    </div>
  </Section>

  <Section title="Outside the lab" index="03" label="Interests">
    <div class="grid grid-2" data-spotlight>
      {interests.map((item, index) => (
        <article class="card" data-reveal style={`--reveal-delay:${index * 70}ms`}>
          <h3>{item.title}</h3>
          <p style="margin-bottom:0">{item.body}</p>
        </article>
      ))}
    </div>
  </Section>

  <Section title="Contact" index="04" label="Say hello">
    <p class="lede" data-reveal style="margin-bottom:var(--space-m)">
      The fastest way to reach me is email. I read everything, and I reply to anything that isn't a
      recruiter template.
    </p>

    <div class="deflist" data-reveal>
      {socials.map((social) => (
        <div class="defrow">
          <span class="defkey">{social.label}</span>
          <span class="defval">
            <a
              href={social.href}
              rel={social.href.startsWith('mailto:') ? 'me' : 'me noopener'}
              target={social.href.startsWith('mailto:') ? undefined : '_blank'}
            >
              {social.handle}
            </a>
          </span>
        </div>
      ))}
    </div>
  </Section>

  <Section title="Colophon" index="05" label="This site">
    <div class="prose-width" data-reveal>
      <p style="color:var(--fg-2)">
        Built with Astro and no client-side framework. Type is Newsreader, Inter, and JetBrains Mono
        — self-hosted, latin-subset variable fonts with metric-matched fallbacks. The hero is a
        particle-track field drawn on canvas, and the social cards are rendered at build time. Every
        page is static HTML.
      </p>
      <p style="margin-top:var(--space-s)">
        <a class="link-arrow" href="/writing/building-this-site">
          <Icon name="arrow-up-right" size="0.9em" />
          Read the build notes
        </a>
      </p>
    </div>
  </Section>
</BaseLayout>

<style>
  .now-card {
    padding: clamp(1.2rem, 2.4vw, 1.8rem);
    border: 1px solid var(--hair);
    border-left: 2px solid var(--warm);
    border-radius: 0 var(--radius) var(--radius) 0;
    background: linear-gradient(to right, var(--warm-soft), transparent 55%), var(--surface);
  }

  .now-stamp {
    margin: 0 0 0.9em;
    font-family: var(--face-mono);
    font-size: var(--step--2);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--fg-4);
  }

  .now-list {
    margin: 0;
    padding-left: 1.1em;
    color: var(--fg-2);
  }

  .now-list li {
    margin-bottom: 0.5em;
  }

  .now-list li::marker {
    color: var(--warm);
  }
</style>
