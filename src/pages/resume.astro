---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Section from '../components/Section.astro';
import Icon from '../components/Icon.astro';
import { profile, contact, education, awards } from '../data/site';
import { formatPeriod, rolesOf, workRoles } from '../lib/experience';
import { publicFileExists } from '../lib/public-file';

/* The download only renders once the PDF is actually in `public/`, so a
   missing file can never ship as a dead link. Said out loud at build time too,
   because on this page the download is the point. */
const hasPdf = publicFileExists(contact.resume);
if (!hasPdf) {
  console.warn(`[resume] public${contact.resume} not found — "Download PDF" is hidden.`);
}
---

<BaseLayout
  title="Resume"
  class="resume-page"
  description={`Resume of Edward Wu — an overview of education, experience, and honours.${hasPdf ? ' Download the full resume as a PDF.' : ' Read the overview and get in touch for the full resume.'}`}
>
  <PageHeader
    slot="hero"
    eyebrow="Resume"
    meta={profile.location}
    title={profile.name}
    lede={`Data science at the University of Michigan. ${hasPdf ? 'Read the overview below or download the full resume.' : 'Read the overview below or get in touch for the full resume.'}`}
  >
    <div class="hero-actions no-print" data-reveal style="--reveal-delay:120ms">
      {hasPdf && (
        <a class="btn btn-primary" href={contact.resume} download>
          Download PDF
          <Icon name="download" />
        </a>
      )}
      <a class="btn btn-quiet" href={`mailto:${contact.email}`}>
        <Icon name="mail" />
        {contact.email}
      </a>
    </div>

    <p class="resume-print-contact">{contact.email}</p>
  </PageHeader>

  <Section title="At a glance" index="01" label="Summary">
    <div class="deflist">
      <div class="defrow" data-reveal>
        <span class="defkey">Education</span>
        <ul class="defval glance">
          {education.map((item) => (
            <li>
              <strong>{item.degree}</strong>
              <span class="glance-meta">
                {item.school} · {item.period}
                {item.gpa && ` · GPA ${item.gpa}`}
              </span>
            </li>
          ))}
        </ul>
      </div>

      {[
        { label: 'Experience', roles: workRoles },
        { label: 'Leadership', roles: rolesOf('leadership') },
      ].map((row) => (
        <div class="defrow" data-reveal>
          <span class="defkey">{row.label}</span>
          <ul class="defval glance">
            {row.roles.map((role) => (
              <li>
                <strong>
                  {role.role} — {role.org}
                </strong>
                <span class="glance-meta">
                  {formatPeriod(role)} · {role.location}
                </span>
              </li>
            ))}
          </ul>
        </div>
      ))}

      <div class="defrow" data-reveal>
        <span class="defkey">Honours</span>
        <ul class="defval glance">
          {awards.map((award) => (
            <li>
              <strong>{award.title}</strong>
              <span class="glance-meta">
                {award.org} · {award.year}
              </span>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <p data-reveal>
      <a class="link-arrow" href="/experience">
        Experience in full
      </a>
    </p>
  </Section>
</BaseLayout>

<style>
  .resume-print-contact {
    display: none;
  }

  @media print {
    :global(.resume-page .page-hero-body) {
      padding-block: 0 14pt;
    }

    :global(.resume-page .page-hero h1) {
      font-size: 22pt;
      margin-block: 5pt 8pt;
    }

    :global(.resume-page .page-hero-lede) {
      font-size: 10pt;
      line-height: 1.45;
      max-width: none;
    }

    :global(.resume-page .section) {
      break-inside: auto;
    }

    .resume-print-contact {
      display: block;
      margin-block: 8pt 0;
      font-size: 9pt;
    }
  }
</style>
