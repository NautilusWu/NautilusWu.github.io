---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Section from '../components/Section.astro';
import Entry from '../components/Entry.astro';
import TagList from '../components/TagList.astro';
import Icon from '../components/Icon.astro';
import { profile, contact, pages, education, experienceGroups, awards, skills } from '../data/site';
import { formatPeriod, rolesOf } from '../lib/experience';

/* The whole resume on one page: education, every role in full, honours, and
   tools. Deliberately no PDF download — the file is shared on request only. */
const page = pages.resume;

const groups = experienceGroups
  .map((group) => ({ ...group, roles: rolesOf(group.kind) }))
  .filter((group) => group.roles.length > 0);

/* Sections number themselves, so adding or emptying one never leaves a gap. */
let section = 0;
const nextIndex = () => String(++section).padStart(2, '0');
---

<BaseLayout title="Resume" class="resume-page" description={page.description}>
  <PageHeader
    slot="hero"
    eyebrow="Resume"
    meta={profile.location}
    title={profile.name}
    lede={page.lede}
  >
    <div class="hero-actions no-print" data-reveal style="--reveal-delay:120ms">
      <a class="btn btn-quiet" href={`mailto:${contact.email}`}>
        <Icon name="mail" />
        {contact.email}
      </a>
    </div>

    <p class="resume-print-contact">{contact.email}</p>
  </PageHeader>

  <Section title="Education" index={nextIndex()} label="Degrees" id="education">
    <ul class="glance schools">
      {education.map((item) => (
        <li class="glance-school" data-reveal>
          {/* Decorative: the school is named right beside it. */}
          <Image class="school-seal" src={item.seal} alt="" width={48} height={48} />
          <span>
            <strong>{item.degree}</strong>
            <span class="glance-meta">
              {item.school} · {item.period}
              {item.gpa && ` · GPA ${item.gpa}`}
            </span>
          </span>
        </li>
      ))}
    </ul>
  </Section>

  {groups.map((group) => (
    <Section title={group.title} index={nextIndex()} label={group.label} id={group.kind}>
      <div class="entries">
        {group.roles.map((role) => (
          <Entry
            title={role.role}
            subtitle={role.org}
            period={formatPeriod(role)}
            place={role.location}
            bullets={role.bullets}
          />
        ))}
      </div>
    </Section>
  ))}

  <Section title="Honours" index={nextIndex()} label="Recognition" id="honours">
    <ul class="glance">
      {awards.map((award) => (
        <li data-reveal>
          <strong>{award.title}</strong>
          <span class="glance-meta">
            {award.org} · {award.year}
          </span>
        </li>
      ))}
    </ul>
  </Section>

  <Section title="Methods and tools" index={nextIndex()} label="Toolkit" id="skills">
    <div class="deflist">
      {skills.map((group) => (
        <div class="defrow" data-reveal>
          <span class="defkey">{group.group}</span>
          <span class="defval">
            <TagList items={group.items} />
          </span>
        </div>
      ))}
    </div>
  </Section>
</BaseLayout>

<style>
  .resume-print-contact {
    display: none;
  }

  .schools {
    gap: 1.1em;
  }

  .glance-school {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    gap: 0.9em;
  }

  /* White disc behind each seal: the UC Irvine seal is thin blue line work
     on a transparent ground and would vanish on the dark theme. */
  .school-seal {
    width: 2.75rem;
    height: 2.75rem;
    padding: 2px;
    border-radius: 50%;
    background: #fff;
    box-shadow: 0 0 0 1px var(--hair-2);
  }

  @media print {
    :global(.resume-page .page-hero-body) {
      padding-block: 0 14pt;
    }

    :global(.resume-page .page-hero h1) {
      font-size: 22pt;
      margin-block: 5pt 8pt;
    }

    :global(.resume-page .page-hero-lede) {
      font-size: 10pt;
      line-height: 1.45;
      max-width: none;
    }

    :global(.resume-page .section) {
      break-inside: auto;
    }

    .resume-print-contact {
      display: block;
      margin-block: 8pt 0;
      font-size: 9pt;
    }
  }
</style>
