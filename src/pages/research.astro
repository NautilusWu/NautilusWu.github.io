---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Section from '../components/Section.astro';
import Entry from '../components/Entry.astro';
import TagList from '../components/TagList.astro';
import { research, skills, education } from '../data/site';
---

<BaseLayout
  title="Research"
  description="Detector simulation and experimental data analysis — straw-tube cluster counting, test-beam calibration, and the tooling around both."
>
  <PageHeader
    eyebrow="Research"
    title="Measuring things carefully, then computing with them"
    lede="My research sits between instrumentation and computation: simulating how a detector responds, and turning what it records into a number you can defend."
  />

  <Section title="Positions" index="01" label="Ongoing">
    <div class="entries">
      {research.map((item) => (
        <Entry {...item} />
      ))}
    </div>
  </Section>

  <Section title="Methods and tools" index="02" label="Toolkit">
    <div class="deflist">
      {skills.map((group) => (
        <div class="defrow" data-reveal>
          <span class="defkey">{group.group}</span>
          <span class="defval">
            <TagList items={group.items} />
          </span>
        </div>
      ))}
    </div>
  </Section>

  <Section title="Training" index="03" label="Education">
    <div class="entries">
      {education.map((item) => (
        <Entry
          title={item.school}
          period={item.period}
          org={item.location}
          role={item.degree}
          bullets={item.details}
        />
      ))}
    </div>
  </Section>
</BaseLayout>
