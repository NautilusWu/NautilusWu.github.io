---
interface Props {
  items: readonly string[];
  accent?: boolean;
  class?: string;
  /** Truncate long lists — the rest are announced but not shown. */
  max?: number;
}

const { items, accent = false, class: className, max } = Astro.props;
const shown = max ? items.slice(0, max) : items;
const hidden = items.length - shown.length;
---

<ul class:list={['tags', className]}>
  {shown.map((item) => (
    <li class:list={['tag', { 'tag-accent': accent }]}>{item}</li>
  ))}
  {hidden > 0 && (
    <li class="tag" aria-label={`and ${hidden} more`}>
      +{hidden}
    </li>
  )}
</ul>
