---
/**
 * One role on /experience: dates and place alongside, then the title, who it
 * was with, and what was done there.
 */
interface Props {
  title: string;
  /** The organisation, shown under the title. */
  subtitle?: string;
  period: string;
  /** Where — a city, or "Remote". */
  place?: string;
  bullets?: readonly string[];
}

const { title, subtitle, period, place, bullets = [] } = Astro.props;
---

<article class="entry" data-reveal>
  <div class="entry-meta">
    <span class="entry-period">{period}</span>
    {place && <span>{place}</span>}
  </div>

  <div class="entry-body">
    <h3>{title}</h3>
    {subtitle && <p class="entry-subtitle">{subtitle}</p>}

    {bullets.length > 0 && (
      <ul>
        {bullets.map((bullet) => (
          <li>{bullet}</li>
        ))}
      </ul>
    )}
  </div>
</article>
