---
/**
 * A slow ticker. The track holds the list twice so the -50% keyframe loops
 * seamlessly; the duplicate is hidden from assistive tech.
 */
interface Props {
  items: readonly string[];
}

const { items } = Astro.props;
---

<div class="marquee" role="group" aria-label="Tools and technologies">
  <div class="marquee-track">
    <div class="marquee-lane">
      {items.map((item) => (
        <span class="marquee-item">{item}</span>
      ))}
    </div>
    <div class="marquee-lane" aria-hidden="true">
      {items.map((item) => (
        <span class="marquee-item">{item}</span>
      ))}
    </div>
  </div>
</div>

<style>
  .marquee-lane {
    display: flex;
    gap: 2.5rem;
    padding-right: 2.5rem;
  }
</style>
