---
/**
 * Inline icon set. Kept as a component rather than an SVG sprite file so the
 * markup ships with the page (no extra request) and `currentColor` works.
 *
 * Every path is drawn on a 24×24 grid with a 1.6 stroke so weights match.
 */
interface Props {
  name: keyof typeof paths;
  size?: string;
  class?: string;
  filled?: boolean;
}

const paths = {
  arrow: '<path d="M5 12h13M12 5.5 18.5 12 12 18.5"/>',
  'arrow-up-right': '<path d="M7 17 17 7M9 7h8v8"/>',
  download: '<path d="M12 4v11M7.5 11 12 15.5 16.5 11M5 19.5h14"/>',
  mail: '<rect x="3" y="5.5" width="18" height="13" rx="2"/><path d="m3.8 7 7.3 5.4a1.5 1.5 0 0 0 1.8 0L20.2 7"/>',
  sun: '<circle cx="12" cy="12" r="4"/><path d="M12 2.5v2M12 19.5v2M4.6 4.6 6 6M18 18l1.4 1.4M2.5 12h2M19.5 12h2M4.6 19.4 6 18M18 6l1.4-1.4"/>',
  moon: '<path d="M20.8 13.2A8.6 8.6 0 1 1 10.8 3.2a6.7 6.7 0 0 0 10 10Z"/>',
  menu: '<path d="M4 7h16M4 12h16M4 17h16"/>',
  close: '<path d="M6 6l12 12M18 6 6 18"/>',
  printer:
    '<path d="M7 9V3.5h10V9M7 17.5H5.5A1.5 1.5 0 0 1 4 16v-5a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v5a1.5 1.5 0 0 1-1.5 1.5H17"/><rect x="7" y="14" width="10" height="6.5" rx="1"/>',
  clock: '<circle cx="12" cy="12" r="8.5"/><path d="M12 7.5V12l3 1.8"/>',
  rss: '<path d="M5 18.5v.1M5 12a7.5 7.5 0 0 1 7.5 7.5M5 5.5A14 14 0 0 1 19 19.5"/>',
  info: '<circle cx="12" cy="12" r="8.5"/><path d="M12 11v5.5M12 7.8v.1"/>',
  spark:
    '<path d="M12 3v4M12 17v4M3 12h4M17 12h4M6.2 6.2 9 9M15 15l2.8 2.8M17.8 6.2 15 9M9 15l-2.8 2.8"/>',
} as const;

const { name, size = '1em', class: className, filled = false } = Astro.props;
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill={filled ? 'currentColor' : 'none'}
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  set:html={paths[name]}
/>
