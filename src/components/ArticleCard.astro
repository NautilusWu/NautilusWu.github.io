---
import Icon from './Icon.astro';
import TagList from './TagList.astro';
import { formatDate, isoDate } from '../lib/format';
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'writing'>;
  readingTime?: number;
}

const { post, readingTime } = Astro.props;
const { title, description, pubDate, tags } = post.data;
---

<a class="card card-link" href={`/writing/${post.id}`} data-reveal>
  <span class="card-index">
    <time datetime={isoDate(pubDate)}>{formatDate(pubDate)}</time>
    {readingTime && <> · {readingTime} min read</>}
  </span>

  <h3>{title}</h3>
  <p>{description}</p>

  <div class="card-foot">
    <TagList items={tags} max={3} />
    <span class="read-more" aria-hidden="true">
      Read <Icon name="arrow" class="icon-arrow" size="0.9em" />
    </span>
  </div>
</a>

<style>
  .read-more {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    font-family: var(--face-mono);
    font-size: var(--step--2);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--fg-3);
    transition: color var(--dur-1) var(--ease);
  }

  .card-link:hover .read-more {
    color: var(--accent);
  }

  .card-link:hover .icon-arrow {
    transform: translateX(0.25em);
  }

  .icon-arrow {
    transition: transform var(--dur-2) var(--ease);
  }
</style>
