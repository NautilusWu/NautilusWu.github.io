---
import { Font } from 'astro:assets';
import { profile } from '../data/site';
import { latinFontUrl } from '../lib/fonts';
import { ogRouteFor, personSchema } from '../lib/seo';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  /** Extra JSON-LD (e.g. BlogPosting) merged in alongside the Person graph. */
  schema?: Record<string, unknown>;
  /** Override the generated Open Graph image route. */
  ogRoute?: string;
  /** `article` for writing pages, `website` elsewhere. */
  ogType?: 'website' | 'article';
  noindex?: boolean;
}

const {
  title,
  description = profile.description,
  schema,
  ogRoute,
  ogType = 'website',
  noindex = false,
} = Astro.props;

const fullTitle = title ? `${title} · ${profile.name}` : `${profile.name} — ${profile.role}`;

/* `Astro.site` is configured in astro.config.mjs; falling back to the request
   origin keeps `astro dev` honest when it isn't set. */
const base = Astro.site ?? new URL(Astro.url.origin);
const canonical = new URL(Astro.url.pathname.replace(/\/+$/, '') || '/', base);
const ogImage = new URL(`/og/${ogRoute ?? ogRouteFor(Astro.url.pathname)}.png`, base);
const feed = new URL('/rss.xml', base);

const graph = [personSchema(base.href), ...(schema ? [schema] : [])];

const fontPreloads = [latinFontUrl('--font-sans', '@fontsource-variable/inter')];
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />

<title>{fullTitle}</title>
<meta name="description" content={description} />
<meta name="author" content={profile.name} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex, nofollow" />}

{/* Inter serves both headings and body copy. Preload its Latin subset;
    the mono face loads on demand. See lib/fonts.ts for subset selection. */}
<Font cssVariable="--font-sans" />
<Font cssVariable="--font-mono" />
{fontPreloads.map((href) => (
  <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />
))}

{/* Mobile browser chrome matches the page background. These are the sRGB
    values `--bg` actually resolves to in each theme, converted from the OKLCH
    tokens rather than eyeballed — a near miss shows as a seam above the page.
    Keep in step with `--bg` in tokens.css. `data-scheme` lets the theme scripts pin the one
    that matches a theme chosen with the toggle. */}
<meta
  name="theme-color"
  content="#fafaf6"
  media="(prefers-color-scheme: light)"
  data-scheme="light"
/>
<meta
  name="theme-color"
  content="#14201c"
  media="(prefers-color-scheme: dark)"
  data-scheme="dark"
/>

<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" sizes="32x32" href="/favicon.ico" />
<link rel="manifest" href="/manifest.webmanifest" />
<link rel="alternate" type="application/rss+xml" title={`${profile.name} — Writing`} href={feed} />
<link rel="sitemap" href="/sitemap-index.xml" />

<meta property="og:type" content={ogType} />
<meta property="og:site_name" content={profile.name} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:locale" content="en_US" />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

<meta name="generator" content={Astro.generator} />

<script type="application/ld+json" set:html={JSON.stringify(graph)} is:inline></script>
{/* The only blocking script on the site. It has to be blocking: the
    alternative is one frame of the wrong theme for anyone who chose dark.
    `.js` gates every reveal animation, so if this never runs, nothing on the
    page is left stuck at `opacity: 0`. */}
<script is:inline>
  (() => {
    const root = document.documentElement;

    const apply = () => {
      let stored = null;
      try {
        stored = localStorage.getItem('theme');
      } catch {
        // Private-mode reads can throw; fall back to the OS preference.
      }
      const dark = stored
        ? stored === 'dark'
        : window.matchMedia('(prefers-color-scheme: dark)').matches;
      root.dataset.theme = dark ? 'dark' : 'light';
      root.classList.add('js');

      /* A theme chosen with the toggle outranks the OS, so the browser chrome
         has to follow it too — otherwise dark on a light-mode phone keeps a
         pale bar above a dark page. Same as `syncThemeColor` in theme.ts. */
      if (stored) {
        document.querySelectorAll('meta[name="theme-color"][data-scheme]').forEach((meta) => {
          meta.media = meta.dataset.scheme === root.dataset.theme ? 'all' : 'not all';
        });
      }
    };

    apply();

    /* A view transition swaps in the incoming document's <html> attributes,
       which drops both `data-theme` and the `js` class — the page would flash
       to light and lose every reveal animation on each navigation.
       `astro:after-swap` runs before the new page paints, so re-applying here
       is invisible. */
    document.addEventListener('astro:after-swap', apply);
  })();
</script>
