---
/**
 * A content section, the same on every page: a mono kicker built from
 * `index` and `label` ("01 / SELECTED WORK"), a bold title, and an optional
 * `aside` slot shown opposite the title.
 */
interface Props {
  title?: string;
  index?: string;
  label?: string;
  id?: string;
  class?: string;
}

const { title, index, label, id, class: className } = Astro.props;
const kicker = [index, label].filter(Boolean).join(' / ');
const hasAside = Astro.slots.has('aside');
---

<section class:list={['section', className]} id={id}>
  {(kicker || title || hasAside) && (
    <div class="section-head">
      <div>
        {kicker && <p class="section-kicker">{kicker}</p>}
        {title && (
          <h2 class="section-title" data-reveal="mask">
            {title}
          </h2>
        )}
      </div>
      {hasAside && (
        <div class="section-aside">
          <slot name="aside" />
        </div>
      )}
    </div>
  )}

  <div class="section-body">
    <slot />
  </div>
</section>
